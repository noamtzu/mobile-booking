# Copy to apps/api/.env for local development.
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
# At least 32 random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-of-32-chars-or-more
# Comma-separated emails that get the admin role when they sign in.
ADMIN_EMAILS=admin@example.com
PORT=3000
# Origin allowed by CORS (the Expo web dev server). Use * only in development.
CORS_ORIGIN=*
# Zone the seed script uses for demo availability.
SEED_TIME_ZONE=Europe/London
